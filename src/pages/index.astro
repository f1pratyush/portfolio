  <section id="hello" class="intro-hero">
    <div class="hero-content">
      <div class="hero-left reveal">
        <span class="pill pill--accent hero-badge">✦ Product Strategy · AI-Native Execution Systems · Zero-to-One Products</span>

        <h2 class="hero-headline display">
          Hey,<br />
          I'm <em>Pratyush!</em>
        </h2>

        <p class="hero-para">
          I build products, operating models, and AI systems that help organisations
          build faster.
        </p>

        <div class="hero-actions">
          <a
            href="/Pratyush%20Shrivastav%20Product%20Manager%20Resume.pdf"
            download="Pratyush Shrivastav Product Manager Resume.pdf"
            class="btn btn--solid"
          >My Resume</a>
          <a
            href="https://www.linkedin.com/in/f1pratyush/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline"
          >
            <img src="/linkedin.png" alt="" class="li-icon" /> LinkedIn
          </a>
        </div>

        <div class="card whatido-card">
          <p class="kicker kicker--accent">What I do</p>
          <ul class="whatido-list">
            <li>
              <span class="whatido-emoji" aria-hidden="true">🧩</span>
              <span>Turn ambiguity into product direction</span>
            </li>
            <li>
              <span class="whatido-emoji" aria-hidden="true">⚙️</span>
              <span>Bridge strategy and engineering</span>
            </li>
            <li>
              <span class="whatido-emoji" aria-hidden="true">🤖</span>
              <span>Build AI-native product workflows</span>
            </li>
            <li>
              <span class="whatido-emoji" aria-hidden="true">🏗️</span>
              <span>Build zero-to-one products</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="hero-right reveal">
        <img src="/img-full.png" alt="Pratyush Shrivastav" class="hero-photo" />
      </div>
    </div>
  </section>

  <section id="portfolio-work" class="section portfolio-work-section">
    <div class="page">
      <div class="section-head reveal">
        <span class="kicker kicker--accent">Featured Work</span>
        <h2>Systems, frameworks and products that demonstrate strategic thinking.</h2>
      </div>

      <div class="portfolio-grid">
        <a href="/work/elderly-ux" class="portfolio-card reveal">
          <div class="card-visual">
            <img src="/elderly-card-image.png" alt="Elderly app interface showing health monitoring" class="card-illustration" />
          </div>
          <div class="card-content">
            <h3 class="card-title">Building for the Elderly</h3>
            <p class="card-subtitle">Designing mobile experiences for people who were never meant to learn smartphones.</p>
            <p class="card-preview">Our mission is to build a digital experience for the elderly that serves them functionally and emotionally—with clarity, ease, and respect. Through six core UX principles—predictable navigation, design that respects hands and eyes, visual hierarchy, intentional simplicity, conversational interfaces, and confidence-building design—we created an app that empowers elderly users instead of challenging them.</p>
            <span class="card-cta">Read the UX Preamble →</span>
          </div>
        </a>

        <a href="/work/sonex" class="portfolio-card reveal">
          <div class="card-visual">
            <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" class="card-illustration">
              <defs>
                <linearGradient id="grad-sonex" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#1a2a4a;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#2d3e5f;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="240" height="160" fill="url(#grad-sonex)" />
              <circle cx="60" cy="80" r="8" fill="#4a9eff" opacity="0.8"/>
              <circle cx="120" cy="50" r="8" fill="#4a9eff" opacity="0.8"/>
              <circle cx="180" cy="100" r="8" fill="#4a9eff" opacity="0.8"/>
              <line x1="60" y1="80" x2="120" y2="50" stroke="#4a9eff" stroke-width="1.5" opacity="0.5"/>
              <line x1="120" y1="50" x2="180" y2="100" stroke="#4a9eff" stroke-width="1.5" opacity="0.5"/>
              <path d="M 60 80 Q 90 65 120 50" stroke="#4a9eff" stroke-width="2" fill="none" opacity="0.3"/>
              <path d="M 120 50 Q 150 75 180 100" stroke="#4a9eff" stroke-width="2" fill="none" opacity="0.3"/>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Sonex</h3>
            <p class="card-subtitle">An AI orchestration layer that turns conversations into product actions.</p>
            <p class="card-preview">Voice is easy. Reliable execution isn't. Sonex translates natural language into structured API calls, allowing AI assistants to interact with real products instead of simply generating text.</p>
            <span class="card-cta">Explore Sonex →</span>
          </div>
        </a>

        <a href="/work/friday" class="portfolio-card reveal">
          <div class="card-visual">
            <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" class="card-illustration">
              <defs>
                <linearGradient id="grad-friday" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#f0e5d8;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#e8dcc9;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="240" height="160" fill="url(#grad-friday)" />
              <rect x="30" y="30" width="50" height="50" rx="4" fill="#ffd93d" opacity="0.7"/>
              <rect x="95" y="35" width="50" height="50" rx="4" fill="#ff6b6b" opacity="0.7"/>
              <rect x="160" y="40" width="50" height="50" rx="4" fill="#4ecdc4" opacity="0.7"/>
              <rect x="50" y="95" width="50" height="45" rx="4" fill="#95e1d3" opacity="0.6"/>
              <rect x="115" y="90" width="50" height="45" rx="4" fill="#f38181" opacity="0.6"/>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Friday</h3>
            <p class="card-subtitle">AI teammates for modern product teams.</p>
            <p class="card-preview">Discovery. Scoping. Prototyping. Documentation. Friday is a collection of specialized AI workflows that remove repetitive work and accelerate product execution across the software lifecycle.</p>
            <span class="card-cta">Meet Friday →</span>
          </div>
        </a>

        <a href="/work/prove" class="portfolio-card reveal">
          <div class="card-visual">
            <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" class="card-illustration">
              <defs>
                <linearGradient id="grad-prove" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#e3f2fd;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#f3e5f5;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="240" height="160" fill="url(#grad-prove)" />
              <line x1="30" y1="130" x2="70" y2="100" stroke="#3b5998" stroke-width="2" opacity="0.6"/>
              <line x1="70" y1="100" x2="110" y2="60" stroke="#3b5998" stroke-width="2" opacity="0.6"/>
              <line x1="110" y1="60" x2="150" y2="80" stroke="#3b5998" stroke-width="2" opacity="0.6"/>
              <line x1="150" y1="80" x2="210" y2="40" stroke="#3b5998" stroke-width="2" opacity="0.6"/>
              <circle cx="30" cy="130" r="5" fill="#3b5998"/>
              <circle cx="70" cy="100" r="5" fill="#3b5998"/>
              <circle cx="110" cy="60" r="5" fill="#3b5998"/>
              <circle cx="150" cy="80" r="5" fill="#3b5998"/>
              <circle cx="210" cy="40" r="5" fill="#3b5998"/>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">PROVE</h3>
            <p class="card-subtitle">From ideas to measurable signal in one week.</p>
            <p class="card-preview">PROVE is an operating model for rapidly validating product hypotheses through aggressively scoped one-week MVPs. It combines structured discovery, disciplined scope and rapid execution into a repeatable system.</p>
            <span class="card-cta">See the Framework →</span>
          </div>
        </a>

        <a href="/work/doc-labs" class="portfolio-card reveal">
          <div class="card-visual">
            <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" class="card-illustration">
              <defs>
                <linearGradient id="grad-docs" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#fef5e7;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#fce4d6;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="240" height="160" fill="url(#grad-docs)" />
              <rect x="40" y="25" width="80" height="110" rx="3" fill="white" stroke="#d4a574" stroke-width="1.5" opacity="0.8"/>
              <line x1="50" y1="40" x2="110" y2="40" stroke="#8b7355" stroke-width="1.5" opacity="0.4"/>
              <line x1="50" y1="55" x2="120" y2="55" stroke="#8b7355" stroke-width="1" opacity="0.3"/>
              <line x1="50" y1="68" x2="120" y2="68" stroke="#8b7355" stroke-width="1" opacity="0.3"/>
              <line x1="50" y1="81" x2="110" y2="81" stroke="#8b7355" stroke-width="1" opacity="0.3"/>
              <rect x="130" y="50" width="70" height="70" rx="2" fill="white" stroke="#c9a875" stroke-width="1.5" opacity="0.7" transform="rotate(15 165 85)"/>
            </svg>
          </div>
          <div class="card-content">
            <h3 class="card-title">Doc Labs</h3>
            <p class="card-subtitle">Where ideas become frameworks.</p>
            <p class="card-preview">Every product teaches something. Doc Labs captures those lessons as reusable playbooks, operating principles and decision frameworks—turning experience into systems others can build with.</p>
            <span class="card-cta">Browse the Labs →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="journey" class="section">
    <div class="page">
      <div class="section-head reveal">
        <span class="kicker kicker--accent">My Journey</span>
        <h2>My career has evolved through four distinct phases</h2>
      </div>

      <ol class="timeline">
        <li class="timeline-item reveal">
          <div class="timeline-marker"><span class="timeline-dot"></span></div>
          <div class="card timeline-card">
            <p class="timeline-phase kicker">Phase I</p>
            <h3 class="timeline-title">Building Products</h3>
            <p class="timeline-era small-sans">Enrole</p>
            <ul class="timeline-list">
              <li>Learned product development from first principles as a founder.</li>
              <li>Built software, talked to customers, sold the product, and owned the complete lifecycle.</li>
            </ul>
          </div>
        </li>

        <li class="timeline-item reveal">
          <div class="timeline-marker"><span class="timeline-dot"></span></div>
          <div class="card timeline-card">
            <p class="timeline-phase kicker">Phase II</p>
            <h3 class="timeline-title">Scaling Products</h3>
            <p class="timeline-era small-sans">Toprankers / ProBano</p>
            <ul class="timeline-list">
              <li>Built products used at scale.</li>
              <li>Focused on automation, algorithms, product-led scale, and operational efficiency.</li>
            </ul>
          </div>
        </li>

        <li class="timeline-item reveal">
          <div class="timeline-marker"><span class="timeline-dot"></span></div>
          <div class="card timeline-card">
            <p class="timeline-phase kicker">Phase III</p>
            <h3 class="timeline-title">Building Across Domains</h3>
            <p class="timeline-era small-sans">PlayVerse</p>
            <ul class="timeline-list">
              <li>Built zero-to-one products across marketplaces, blockchain gaming, fantasy sports, and commerce.</li>
              <li>Learned that great product thinking transfers across industries.</li>
            </ul>
          </div>
        </li>

        <li class="timeline-item reveal">
          <div class="timeline-marker"><span class="timeline-dot"></span></div>
          <div class="card timeline-card">
            <p class="timeline-phase kicker">Phase IV</p>
            <h3 class="timeline-title">Building Product Systems</h3>
            <p class="timeline-era small-sans">Utsuk</p>
            <ul class="timeline-list">
              <li>Designed <strong>PROVE</strong>, a hypothesis-to-MVP framework that became the company's default operating model for PoC execution.</li>
              <li>Built AI workflows that accelerate product discovery, scoping, and rapid prototyping.</li>
              <li>Conceived <strong>Friday</strong>, an AI-powered project intelligence initiative.</li>
              <li>Created <strong>Sonex</strong>, a speech-to-intent SDK for embedding AI assistant experiences into applications.</li>
              <li>Worked directly with the CEO and CFO on AI transformation and new product incubation.</li>
            </ul>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section id="how-i-work" class="section">
    <div class="page">
      <div class="section-head reveal">
        <span class="kicker kicker--accent">How I Work</span>
        <h2>Five ideas I keep returning to.</h2>
      </div>

      <div class="principles">
        <div class="principle reveal">
          <span class="principle-num kicker">01</span>
          <div>
            <h3 class="principle-title">Start with uncertainty</h3>
            <p class="principle-lead">Every product begins with uncertainty.</p>
            <p class="principle-body">
              Before discussing solutions, I identify what we know, what we're assuming,
              and which assumptions matter the most. The goal isn't to eliminate
              uncertainty<span class="principle-punch">—it's to make it explicit</span>.
            </p>
          </div>
        </div>

        <div class="principle reveal">
          <span class="principle-num kicker">02</span>
          <div>
            <h3 class="principle-title">Listen before you solve</h3>
            <p class="principle-lead">
              The people closest to the problem usually understand it better than anyone
              in the meeting room.
            </p>
            <p class="principle-body">
              When building products for truck drivers, warehouse operators, caregivers,
              or construction teams, I spend time understanding how work actually happens.
              Executives understand goals. Users understand reality. My job is to bridge
              the two.
            </p>
            <p class="principle-body principle-punch">
              Domain expertise isn't something I walk in with. It's something I earn by
              listening.
            </p>
          </div>
        </div>

        <div class="principle reveal">
          <span class="principle-num kicker">03</span>
          <div>
            <h3 class="principle-title">Chase the fastest measurable signal</h3>
            <p class="principle-lead">I don't optimize for building an MVP.</p>
            <p class="principle-body">
              I optimize for creating the earliest measurable signal that tells us
              whether we're moving in the right direction.
            </p>
            <p class="principle-body">
              Sometimes that's five customer interviews. Sometimes it's a prototype.
              Sometimes it's a one-week proof of concept.
            </p>
            <p class="principle-body principle-punch">The artifact changes. Learning doesn't.</p>
          </div>
        </div>

        <div class="principle reveal">
          <span class="principle-num kicker">04</span>
          <div>
            <h3 class="principle-title">Design systems, not heroics</h3>
            <p class="principle-lead">Great products aren't built by exceptional Product Managers.</p>
            <p class="principle-body">
              They're built by teams with repeatable ways of discovering, validating, and
              delivering products.
            </p>
            <p class="principle-body">
              That's why I enjoy designing operating models and execution frameworks just
              as much as building products themselves.
            </p>
          </div>
        </div>

        <div class="principle reveal">
          <span class="principle-num kicker">05</span>
          <div>
            <h3 class="principle-title">AI should amplify judgment, not replace it</h3>
            <p class="principle-lead">
              AI is exceptional at compressing repetitive work—discovery synthesis,
              product scoping, documentation, and rapid prototyping.
            </p>
            <p class="principle-body">The objective isn't fewer Product Managers.</p>
            <p class="principle-body principle-punch">
              It's giving product teams more time to think, make better decisions, and
              solve harder problems.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="page">
      <div class="section-head reveal">
        <span class="kicker kicker--accent">Work I'm Proud Of</span>
        <h2>Some of what I've built.</h2>
      </div>

      <div class="work-grid">
        <div class="card work-card reveal">
          <p class="kicker kicker--accent">Enrole</p>
          <h3 class="work-title">Learning product management from first principles</h3>
          <p>
            Enrole was where I learned that products aren't validated when they're
            shipped—they're validated when customers choose them.
          </p>
          <p>
            As a founder, I wore every hat: product, engineering, sales, customer
            support, and implementation. Building software was only half the job. The
            other half was understanding why people would—or wouldn't—use it.
          </p>
          <p class="work-punch">It shaped the way I approach every product today.</p>
        </div>

        <div class="card work-card reveal">
          <p class="kicker kicker--accent">PROVE</p>
          <h3 class="work-title">Reimagining how consulting teams build products</h3>
          <p>Most Proof of Concepts fail because they try to prove too much.</p>
          <p>
            PROVE challenged that assumption by redefining success around learning
            velocity instead of feature completeness. It introduced clear
            hypothesis-driven execution, strict scope boundaries, and rapid validation
            cycles, eventually becoming Utsuk's default operating model for new PoC
            engagements.
          </p>
          <p class="work-punch">
            It wasn't just a framework—it changed how the organization approached product
            discovery.
          </p>
        </div>

        <div class="card work-card reveal">
          <p class="kicker kicker--accent">Friday</p>
          <h3 class="work-title">Bringing intelligence to product execution</h3>
          <p>Requirements don't drift because teams stop communicating.</p>
          <p>They drift because context changes faster than documentation.</p>
          <p>
            Friday explores how AI can continuously understand evolving project context,
            surface hidden risks, detect requirement drift, and help teams make better
            decisions throughout product development.
          </p>
          <p class="work-punch">
            It's my attempt at bringing continuous intelligence into product execution.
          </p>
        </div>

        <div class="card work-card reveal">
          <p class="kicker kicker--accent">Sonex</p>
          <h3 class="work-title">Making AI experiences effortless for developers</h3>
          <p>
            As AI becomes a standard part of modern applications, developers shouldn't
            have to rebuild the same assistant experience every time.
          </p>
          <p>
            Sonex is a speech-to-intent SDK that enables developers to embed AI assistant
            experiences into their applications within minutes.
          </p>
          <p class="work-punch">
            My goal is simple: make natural language interaction as easy to integrate as
            authentication, analytics, or payments.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- section 1: epistemology, must fit in one viewport (desktop only —
     mobile has too little width for this content to also fit the height cap) ---- */
  .hero-fit {
    position: relative;
    display: flex;
    align-items: flex-start;
  }
  @media (min-width: 760px) {
    .hero-fit { max-height: calc(100dvh - 4.25rem); }
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--w-page);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero-fit .hero-content {
    padding-block-start: clamp(2rem, 6vh, 4rem);
    padding-block-end: clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }

  /* full-width definition strip — wide, not tall */
  .epi-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 1.1rem;
    row-gap: 0.4rem;
    padding-bottom: clamp(1.25rem, 3.5vh, 2rem);
    border-bottom: 1px solid var(--hairline-strong);
  }
  .epi-term {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .epi-word {
    font-size: clamp(1.6rem, 4.6vh, 2.3rem);
    letter-spacing: -0.02em;
  }
  .epi-ipa {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .epi-pos { font-style: italic; }
  .epi-divider {
    display: none;
  }
  @media (min-width: 640px) {
    .epi-divider {
      display: block;
      width: 1px;
      align-self: stretch;
      background: var(--hairline-strong);
      margin-inline: 0.4rem;
    }
  }
  .epi-def {
    flex: 1 1 260px;
  }
  @media (min-width: 700px) {
    .epi-def { white-space: nowrap; }
  }

  /* headline, then sentences below — one column, full width */
  .epi-beat {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3.5vh, 2.25rem);
  }
  .epi-headline {
    font-size: clamp(1.8rem, 5.2vh, 2.9rem);
    letter-spacing: -0.02em;
    text-align: center;
    max-width: none;
    width: 100%;
  }
  .epi-headline em { font-style: italic; color: var(--accent); }

  /* statement → rationale → conclusion, a visible line of reasoning */
  .epi-logic {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 2.2vh, 1.25rem);
    max-width: 74ch;
    margin-inline: auto;
  }

  .epi-statement {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.15rem, 3vh, 1.5rem);
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .epi-statement em { font-style: italic; color: var(--accent); }

  .epi-rationale {
    display: flex;
    gap: 0.6em;
    font-family: var(--sans);
    font-size: clamp(0.88rem, 2.1vh, 1rem);
    line-height: 1.55;
    color: var(--ink-faint);
    padding-left: 0.9rem;
  }
  .epi-connector {
    color: var(--hairline-strong);
    flex-shrink: 0;
  }
  .epi-rationale em {
    font-style: italic;
    color: var(--accent);
    font-weight: 600;
  }

  .epi-conclusion {
    font-family: var(--serif);
